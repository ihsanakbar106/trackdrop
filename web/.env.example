APP_NAME="Shopify PHP App"
APP_ENV=local
APP_KEY=
APP_DEBUG=true

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# The path to the database file should be absolute, make sure to update it!
DB_DATABASE=storage/db.sqlite
DB_FOREIGN_KEYS=true

SHOPIFY_API_VERSION=2026-07
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Official Google Cloud Translation API (Basic v2) — tracking page
# Dev/prod free tier: ~500,000 characters/month after enabling the API in a Cloud project
GOOGLE_TRANSLATE_API_KEY=
